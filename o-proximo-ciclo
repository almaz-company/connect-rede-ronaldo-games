    <div class="top" style="position:absolute;top:70px;left:90px;right:90px"><span class="sec">Almaz × Rede Ronaldo Games</span><span>29.10.2026</span></div>
    <div class="r" style="--d:0">${LOGO}</div>
    <div class="tag r" style="--d:150"><i></i>OBRIGADO PELA CONVERSA</div>
    <h1><span class="m"><span style="--d:250">Vamos começar</span></span><span class="m"><span style="--d:380">a <span class="v glitch" style="--d:900">operação</span> <span class="o">juntos</span>.</span></span></h1>
    <div class="endrow r" style="--d:800">
      <div><b>01</b>Definir prioridades</div><div><b>02</b>Confirmar responsáveis</div><div><b>03</b>Acordar o escopo</div><div><b>04</b>Iniciar a operação</div>
    </div>
    <div class="press r" style="--d:1100">PRESS START<span>_</span></div>
    <div class="marq"><div>${"ALMAZ × REDE RONALDO GAMES • PROGRAMAÇÃO • AUDIÊNCIA • PR INSTITUCIONAL • COMERCIAL • 2027 • ".repeat(4)}</div></div>
    <div class="foot">Almaz  |  Rede Ronaldo Games  |  29.10.2026</div></div>`;
  let b="";const it=s.items||[];
  if(s.type==="cards"){
    b=(s.banner?`<div style="width:100%"><div class="banner r" style="--d:400">${s.banner}</div>`:"")+
    `<div class="grid al" style="grid-template-columns:repeat(${s.cols},1fr)">`+it.map((x,j)=>card(x,j,s.num?pad(j+1):"◆ "+pad(j+1),450+j*110)).join("")+`</div>`+(s.banner?"</div>":"");
  }
  if(s.type==="duo") b=`<div class="duo">`+it.map((x,j)=>card(x,j,j?"◆ B":"◆ A",450+j*160)).join("")+`</div>`;
  if(s.type==="steps"){const n=it.length,dur=n*700;
    b=`<div class="steps" style="grid-template-columns:repeat(${n},1fr);--seg:${n*6};--dur:${dur}ms"><div class="xp"><span>PROGRESSO</span><div class="tr"><div class="fl"></div><i class="sh"></i></div><b class="pct" data-dur="${dur}">0%</b></div><div class="ln"><i></i><em></em></div>`+
    it.map((x,j)=>{const u=450+(n>1?j/(n-1):0)*dur;return `<div class="step r" style="--d:${300+j*120};--u:${u}"><div class="dot">${s.lbl?s.lbl[j]:pad(j+1)}</div><div class="chk">ETAPA ${pad(j+1)} / ${pad(n)}</div><h3>${x[0]}</h3><p>${x[1]}</p></div>`}).join("")+`</div>`;}
  if(s.type==="chain") b=`<div class="chain">`+it.map((x,j)=>card(x,j,["◆ RRG","◆ CREATOR","◆ MARCA"][j],450+j*220)+(j<2?`<div class="arrow r" style="--d:${560+j*220}">→</div>`:"")).join("")+`</div>`;
  if(s.type==="tl") b=`<div class="tl"><i class="tln"></i>`+it.map((x,j)=>`<div class="ev r" style="--d:${300+j*90};--u:${450+j*(2600/6)}"><div class="dt">${x[0]}</div><h3>${x[1]}</h3><p>${x[2]}</p></div>`).join("")+`</div>`;
  if(s.type==="table") b=`<table class="tbl r" style="--d:450"><thead><tr><th>FRENTE</th><th>ALMAZ</th><th>REDE RONALDO GAMES</th></tr></thead><tbody>`+it.map(x=>`<tr><td>${x[0]}</td><td>${x[1]}</td><td>${x[2]}</td></tr>`).join("")+`</tbody></table>`;
  if(s.type==="stats") b=`<div style="width:100%;display:grid;grid-template-columns:1.25fr 1fr;gap:40px;align-items:stretch">
    <div class="grid" style="grid-template-columns:1fr 1fr;gap:18px">
      ${[["1.81","mi","Visualizações em 30 dias","v"],["847","mil","Visualizadores em 30 dias",""],["90.5","%","Views de não seguidores","v"],["+180","","Seguidores líquidos","p"]].map((x,j)=>`<div class="card r" style="--d:${450+j*110};padding:24px 26px"><div class="big ${x[3]}" style="font-size:58px"><span class="cnt" data-v="${x[0]}">0</span><small style="font-size:30px"> ${x[1]}</small></div><div class="lbl">${x[2]}</div><i class="bar" style="--d:${450+j*110}"></i></div>`).join("")}
    </div>
    <div class="card r" style="--d:700;display:flex;flex-direction:column">
      <div class="k">VISUALIZAÇÕES MENSAIS: COMPARAÇÃO DAS JANELAS</div>
      <div style="flex:1;display:flex;align-items:flex-end;gap:40px;padding:10px 20px 0">
        <div style="flex:1;text-align:center"><div style="font:800 30px Unbounded;margin-bottom:10px">4,09 mi</div><div class="cbar" style="--h:100%;background:rgba(255,255,255,.18)"></div><div class="lbl">Média dos 60 dias anteriores</div></div>
        <div style="flex:1;text-align:center"><div style="font:800 30px Unbounded;margin-bottom:10px;color:var(--volt)">1,81 mi</div><div class="cbar" style="--h:44%;background:var(--volt)"></div><div class="lbl">Últimos 30 dias</div></div>
      </div>
      <div style="margin-top:14px;display:flex;align-items:baseline;gap:14px"><span class="big p" style="font-size:46px">−55,6%</span><span class="lbl" style="margin:0">na comparação mensal</span></div>
    </div></div>`;
  if(s.type==="demo") b=`<div style="width:100%;display:grid;grid-template-columns:repeat(3,1fr);gap:22px">`+
    [[52.4,"52,4%","entre 25 e 44 anos","Mais da metade dos seguidores do Instagram está nesta faixa. Há espaço para testar formatos ligados a cultura pop, nostalgia e games.","#d4ff1e"],
     [30.2,"30,2%","de mulheres","A participação feminina já faz parte da comunidade. Vale investigar os conteúdos de maior interesse desse público.","#ff2e7e"],
     [89.6,"89,6%","no Brasil","A concentração nacional favorece propostas de marcas, experiências presenciais e uma agenda voltada ao mercado brasileiro.","#22e4ff"]]
    .map((x,j)=>`<div class="card r" style="--d:${450+j*150};text-align:center"><svg viewBox="0 0 120 120" width="190" height="190" style="margin:0 auto 18px;display:block"><circle cx="60" cy="60" r="50" fill="none" stroke="rgba(255,255,255,.08)" stroke-width="10"/><circle class="ring" cx="60" cy="60" r="50" fill="none" stroke="${x[4]}" stroke-width="8" stroke-linecap="round" stroke-dasharray="314" stroke-dashoffset="314" data-p="${x[0]}" transform="rotate(-90 60 60)" style="filter:drop-shadow(0 0 8px ${x[4]})"/><text x="60" y="68" text-anchor="middle" fill="#fff" font-family="Unbounded" font-weight="700" font-size="14" letter-spacing="-.3">${x[1]}</text></svg><h3>${x[2]}</h3><p>${x[3]}</p></div>`).join("")+`</div>`;
  if(s.type==="copa") b=`<div style="width:100%"><div class="banner r" style="--d:400">PROJETO PRINCIPAL DA REDE RONALDO</div><div class="banner pk r" style="--d:520;font-size:20px;margin-left:80px;margin-right:80px">ATIVAÇÃO GAMER DESENVOLVIDA EM COLABORAÇÃO</div><div class="grid al" style="grid-template-columns:repeat(3,1fr);padding:0 160px">`+
    [["Estações de jogos","Desafios com o público"],["Creators convidados","Conteúdo e comunidade"],["Marcas participantes","Patrocínio e experiências"]].map((x,j)=>card(x,j,"◆ "+pad(j+1),650+j*130)).join("")+`</div></div>`;
  return `<div class="slide t-${s.type}">${head(s,i)}<div class="body">${b}</div>${s.note?`<div class="note r" style="--d:1000">${s.note}</div>`:""}
  <div class="num">${pad(i+1)}</div><div class="foot">${DATE}</div></div>`;
}
const css=document.createElement("style");css.textContent=`.cbar{height:300px;position:relative;margin-bottom:14px}.cbar{transform-origin:bottom;transform:scaleY(0);height:calc(300px * var(--h)/100%)}.slide.on .cbar{animation:grow 1.4s var(--ease) .8s forwards}@keyframes grow{to{transform:scaleY(1)}}`;
document.head.appendChild(css);
const stage=document.getElementById("stage");
stage.innerHTML=S.map(render).join("");
stage.querySelectorAll(".cbar").forEach(b=>{b.style.height=(parseFloat(b.style.getPropertyValue("--h"))*1.5)+"px"});
const slides=[...stage.children];

/* scale */
function fit(){const k=Math.min(innerWidth/1600,innerHeight/900);stage.style.transform=`translate(-50%,-50%) scale(${k})`}
addEventListener("resize",fit);fit();

/* nav */
let cur=-1,busy=false;
const wipe=document.getElementById("wipe");wipe.innerHTML=Array.from({length:6},(_,i)=>`<i style="--n:${i}"></i>`).join("");
function counters(sl){
  sl.querySelectorAll(".cnt").forEach(e=>{const t=e.dataset.v,plus=t[0]==="+",v=parseFloat(t.replace("+","")),dec=t.includes(".")?(t.split(".")[1].length):0;let st=null;
    const f=ts=>{st??=ts;const p=Math.min((ts-st)/1400,1),e2=1-Math.pow(1-p,4);e.textContent=(plus?"+":"")+(v*e2).toFixed(dec).replace(".",",");if(p<1)requestAnimationFrame(f)};setTimeout(()=>requestAnimationFrame(f),500)});
  sl.querySelectorAll(".pct").forEach(e=>{const D=+e.dataset.dur;let st=null;e.textContent="0%";const f=ts=>{st??=ts;const p=Math.min((ts-st)/D,1);e.textContent=Math.round(p*100)+"%";if(p<1)requestAnimationFrame(f)};setTimeout(()=>requestAnimationFrame(f),450)});
  sl.querySelectorAll(".ring").forEach(r=>{r.style.transition="none";r.style.strokeDashoffset=314;requestAnimationFrame(()=>requestAnimationFrame(()=>{r.style.transition="stroke-dashoffset 1.8s cubic-bezier(.16,1,.3,1) .6s";r.style.strokeDashoffset=314*(1-r.dataset.p/100)}))});
}
function go(n,instant){
  n=Math.max(0,Math.min(slides.length-1,n));if(n===cur||busy)return;busy=true;
  const show=()=>{if(cur>=0)slides[cur].classList.remove("on");cur=n;slides[n].classList.add("on");counters(slides[n]);
    document.getElementById("count").textContent=pad(n+1)+" / "+slides.length;
    document.querySelector("#hud i").style.width=((n+1)/slides.length*100)+"%";try{history.replaceState(null,"","#"+(n+1))}catch(_){}burst();};
  if(instant){show();busy=false;return}
  wipe.classList.remove("go");void wipe.offsetWidth;wipe.classList.add("go");
  setTimeout(show,330);setTimeout(()=>{busy=false},560);
}
addEventListener("keydown",e=>{
  if(["ArrowRight","PageDown"," ","Enter"].includes(e.key)){e.preventDefault();go(cur+1)}
  else if(["ArrowLeft","PageUp","Backspace"].includes(e.key)){e.preventDefault();go(cur-1)}
  else if(e.key==="Home")go(0);else if(e.key==="End")go(slides.length-1);
  else if(e.key.toLowerCase()==="f")fs();else if(e.key.toLowerCase()==="m"||e.key==="Escape")menu(e.key!=="Escape"?undefined:false);
});
document.getElementById("nx").onclick=()=>go(cur+1);document.getElementById("pv").onclick=()=>go(cur-1);
function fs(){document.fullscreenElement?document.exitFullscreen():document.documentElement.requestFullscreen?.()}
document.getElementById("fs").onclick=fs;
let wl=0;addEventListener("wheel",e=>{const t=Date.now();if(t-wl<700||Math.abs(e.deltaY)<20)return;wl=t;go(cur+(e.deltaY>0?1:-1))},{passive:true});
let tx=null;addEventListener("touchstart",e=>tx=e.touches[0].clientX,{passive:true});
addEventListener("touchend",e=>{if(tx==null)return;const d=e.changedTouches[0].clientX-tx;if(Math.abs(d)>50)go(cur+(d<0?1:-1));tx=null},{passive:true});
const M=document.getElementById("menu");
document.getElementById("ml").innerHTML=S.map((s,i)=>`<li data-i="${i}"><span>${pad(i+1)}</span>${s.type==="cover"?"Abertura: Almaz × Rede Ronaldo Games":s.type==="end"?"Encerramento":plain(s.t)}</li>`).join("");
M.onclick=e=>{const li=e.target.closest("li");if(li){menu(false);go(+li.dataset.i)}else menu(false)};
function menu(v){M.classList.toggle("on",v)}
document.getElementById("mn").onclick=()=>menu(true);

/* cursor */
const C=document.getElementById("cur");let mx=innerWidth/2,my=innerHeight/2;
addEventListener("pointermove",e=>{mx=e.clientX;my=e.clientY;C.style.left=mx+"px";C.style.top=my+"px"});
document.addEventListener("pointerover",e=>{const h=e.target.closest(".card,button,li");C.style.width=C.style.height=h?"60px":"26px";C.style.background=h?"rgba(212,255,30,.25)":"transparent"});

/* canvas fx: grid em perspectiva + partículas reativas */
const cv=document.getElementById("fx"),cx=cv.getContext("2d");let W,H,DPR;
function rs(){DPR=Math.min(devicePixelRatio||1,1.5);W=cv.width=innerWidth*DPR;H=cv.height=innerHeight*DPR}
addEventListener("resize",rs);rs();
const P=Array.from({length:70},()=>({x:Math.random(),y:Math.random(),z:Math.random()*.8+.2,c:Math.random()<.75?"212,255,30":Math.random()<.5?"255,46,126":"34,228,255"}));
let boost=0;function burst(){boost=1}
let t0=0,last=0,vis=true;document.addEventListener("visibilitychange",()=>vis=!document.hidden);
function loop(ts){requestAnimationFrame(loop);if(!vis||ts-last<16)return;last=ts;t0+=.004+boost*.03;boost*=.94;
  cx.clearRect(0,0,W,H);
  const g=cx.createRadialGradient(W*.75,H*.2,0,W*.75,H*.2,W*.6);g.addColorStop(0,`rgba(212,255,30,${.07+boost*.08})`);g.addColorStop(1,"transparent");cx.fillStyle=g;cx.fillRect(0,0,W,H);
  const g2=cx.createRadialGradient(W*.1,H*.95,0,W*.1,H*.95,W*.5);g2.addColorStop(0,"rgba(255,46,126,.08)");g2.addColorStop(1,"transparent");cx.fillStyle=g2;cx.fillRect(0,0,W,H);
  // perspective grid floor
  const hz=H*.62,ox=(mx/innerWidth-.5)*60*DPR;cx.lineWidth=1*DPR;
  for(let i=-14;i<=14;i++){cx.strokeStyle=`rgba(212,255,30,${.07})`;cx.beginPath();cx.moveTo(W/2+i*20*DPR+ox*.2,hz);cx.lineTo(W/2+i*W*.12+ox,H);cx.stroke()}
  for(let j=0;j<14;j++){const p=((j+(t0*6)%1)/14);const y=hz+(H-hz)*p*p;cx.strokeStyle=`rgba(212,255,30,${.02+p*.1})`;cx.beginPath();cx.moveTo(0,y);cx.lineTo(W,y);cx.stroke()}
  // particles
  const px=(mx/innerWidth-.5),py=(my/innerHeight-.5);
  for(const p of P){p.y-=(.0007+boost*.01)*p.z;if(p.y<-.05){p.y=1.05;p.x=Math.random()}
    const x=(p.x+px*.03*p.z)*W,y=(p.y+py*.03*p.z)*H,r=p.z*2.2*DPR;
    cx.fillStyle=`rgba(${p.c},${.25+p.z*.5})`;cx.fillRect(x,y,r,r);
    if(boost>.05){cx.fillRect(x,y,r,r*(1+boost*30))}}
}
requestAnimationFrame(loop);

go((parseInt(location.hash.slice(1))||1)-1,true);
</script>
